# Lemur AI - Environment Variables
# Copy this file to .env.local for local development, or add these variables in your deployment dashboard (Vercel, Netlify, etc.)

# Google Gemini API Key (Get a free key at https://aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenRouter API Key (Get a free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
